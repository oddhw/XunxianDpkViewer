                                                        <TextBlock Text="图标 / 模型 / 贴图" Foreground="{StaticResource AccentTextBrush}" FontWeight="SemiBold" />
                                                        <ItemsControl x:Name="GlobalSearchResourceSectionList">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Spacing="6" Margin="0,4,0,10">
                                                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource AccentTextBrush}" FontSize="12" FontWeight="SemiBold" />
                                                                        <ItemsControl ItemsSource="{Binding Links}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Button Tag="{Binding}"
