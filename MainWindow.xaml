                                                            <TextBlock Text="完整模型" Foreground="{StaticResource AccentTextBrush}" FontWeight="SemiBold" />
                                                            <TextBlock x:Name="GlobalSearchModelStatusText"
                                                                       Grid.Column="1"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       FontSize="11" />
