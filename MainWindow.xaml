<Window
    x:Class="XunxianDpkViewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="寻仙 DPK 资源浏览器">

    <Grid Background="{StaticResource AppBackgroundBrush}" RequestedTheme="Dark" Loaded="MainWindow_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Background="{StaticResource TopBarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="30" Height="30" Margin="14,0,10,0" CornerRadius="7" Background="{StaticResource SurfaceRaisedBrush}">
                <Image Source="Assets/XunxianIcon.png" Width="24" Height="24" Stretch="Uniform" />
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="寻仙 DPK 资源浏览器"
                           Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="14" />
                <Border Padding="7,2" CornerRadius="8" Background="{StaticResource AccentSurfaceBrush}">
                    <TextBlock x:Name="AppVersionBadgeText" Foreground="{StaticResource AccentTextBrush}" FontSize="10" />
                </Border>
            </StackPanel>
            <TextBlock Grid.Column="2" x:Name="ArchiveSummaryText" Margin="0,0,16,0"
                       VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
        </Grid>

        <NavigationView x:Name="CategoryNavigation"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsPaneOpen="True"
                        OpenPaneLength="188"
                        CompactPaneLength="56"
                        Background="{StaticResource NavigationBrush}"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False"
                        SelectionChanged="CategoryNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="ImageNavigationItem" Content="图标与贴图" Tag="image" IsSelected="True" Foreground="{StaticResource PrimaryTextBrush}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEB9F;" Foreground="{StaticResource AccentTextBrush}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="声音" Tag="sound" Foreground="{StaticResource PrimaryTextBrush}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D6;" Foreground="{StaticResource AccentTextBrush}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ModelNavigationItem" Content="模型" Tag="model" Foreground="{StaticResource PrimaryTextBrush}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE809;" Foreground="{StaticResource AccentTextBrush}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="字体" Tag="font" Foreground="{StaticResource PrimaryTextBrush}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D2;" Foreground="{StaticResource AccentTextBrush}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="MbNavigationItem" Content="MB 表" Tag="mb" Foreground="{StaticResource PrimaryTextBrush}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;" Foreground="{StaticResource AccentTextBrush}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="GlobalSearchNavigationItem" Content="全局资料" Tag="global" Foreground="{StaticResource PrimaryTextBrush}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE721;" Foreground="{StaticResource AccentTextBrush}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DungeonNavigationItem" Content="副本怪物（停用）" Tag="dungeon" Foreground="{StaticResource PrimaryTextBrush}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7FC;" Foreground="{StaticResource AccentTextBrush}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.Content>
                <Grid Padding="20,14,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="PageTitleText" Text="图标与贴图" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock x:Name="PageDescriptionText" Text="浏览 GUI 图标、装备图和场景贴图" Margin="0,3,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Click="OpenFolderButton_Click" ToolTipService.ToolTip="选择包含 DPK 的 res 目录">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                    <TextBlock Text="打开资源目录" />
                                </StackPanel>
                            </Button>
                            <Button Click="OpenArchiveButton_Click" ToolTipService.ToolTip="打开单个 DPK 文件">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                    <TextBlock Text="打开 DPK" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BatchExportButton" Click="BatchExportButton_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                    <TextBlock Text="导出查询结果" />
                                </StackPanel>
                            </Button>
                            <Button Click="SettingsButton_Click" ToolTipService.ToolTip="设置资源目录">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                                    <TextBlock Text="设置" />
                                </StackPanel>
                            </Button>
                            <Button Click="AboutButton_Click" ToolTipService.ToolTip="版本与作者信息">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE946;" FontSize="14" />
                                    <TextBlock Text="关于" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,18,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox x:Name="SearchBox"
                                        Height="40"
                                        VerticalAlignment="Center"
                                        PlaceholderText="搜索文件名或资源路径"
                                        TextChanged="SearchBox_TextChanged" />
                        <ComboBox x:Name="SortComboBox"
                                  Grid.Column="1"
                                  Margin="10,0,0,0"
                                  Height="40"
                                  VerticalAlignment="Center"
                                  SelectedIndex="0"
                                  SelectionChanged="SortComboBox_SelectionChanged"
                                  ToolTipService.ToolTip="排序方式">
                            <ComboBoxItem Content="名称：自然升序" />
                            <ComboBoxItem Content="名称：自然降序" />
                            <ComboBoxItem Content="类型，再按名称" />
                            <ComboBoxItem Content="包内完整路径" />
                            <ComboBoxItem Content="DPK 原始顺序" />
                        </ComboBox>
                        <ToggleSwitch x:Name="BeginnerModeToggle"
                                      Grid.Column="2"
                                      Margin="16,0,0,0"
                                      Header=""
                                      Visibility="Collapsed"
                                      IsOn="False"
                                      OnContent=""
                                      OffContent=""
                                      Toggled="BeginnerModeToggle_Toggled" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="10">
                            <ProgressRing x:Name="BusyRing" Width="18" Height="18" IsActive="False" />
                            <TextBlock x:Name="StatusText" Foreground="{StaticResource SecondaryTextBrush}" Text="等待载入资源" />
                            <TextBlock x:Name="CurrentPathText" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="WorkspaceGrid" Grid.Row="2" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="AssetListColumn" Width="1.35*" MinWidth="340" />
                            <ColumnDefinition x:Name="PreviewColumn" Width="1*" MinWidth="360" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="AssetBrowserPanel" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="10">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="FolderTreeColumn" Width="230" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Margin="8,6,8,8" Spacing="3">
                                            <TextBlock x:Name="FolderTreeTitleText" Text="DPK 目录" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" />
                                            <TextBlock x:Name="FolderTreeHintText" Text="按包内真实路径浏览" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                        </StackPanel>
                                        <TreeView x:Name="FolderTree"
                                                  Grid.Row="1"
                                                  SelectionMode="Single"
                                                  SelectionChanged="FolderTree_SelectionChanged" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="9" Padding="8,5" Margin="0,0,0,8">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="CurrentFolderText"
                                                       VerticalAlignment="Center"
                                                       Text="尚未选择目录"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Button x:Name="MultiSelectButton" Grid.Column="1" Content="多选" Padding="10,4" Click="ToggleMultiSelectButton_Click" />
                                            <Button x:Name="SelectAllButton" Grid.Column="2" Content="全选" Padding="10,4" Visibility="Collapsed" Click="SelectAllButton_Click" />
                                            <Button x:Name="ClearSelectionButton" Grid.Column="3" Content="清除" Padding="10,4" Visibility="Collapsed" Click="ClearSelectionButton_Click" />
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Row="1">
                                <GridView x:Name="ImageGrid"
                                          SelectionChanged="Asset_SelectionChanged"
                                          ContainerContentChanging="ImageGrid_ContainerContentChanging"
                                          IsMultiSelectCheckBoxEnabled="False"
                                          SelectionMode="Single">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                    <GridView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="160" Height="196" Margin="4" Padding="10"
                                                    AutomationProperties.Name="{Binding Name}"
                                                    Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="128" />
                                                        <RowDefinition Height="48" />
                                                    </Grid.RowDefinitions>
                                                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Height="128">
                                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="8" />
                                                    </Border>
                                                    <StackPanel Grid.Row="1" Margin="1,8,1,0">
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxLines="1" Foreground="{StaticResource PrimaryTextBrush}" FontSize="12" />
                                                        <TextBlock Text="{Binding ArchiveName}" TextTrimming="CharacterEllipsis" MaxLines="1" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>

                                <ListView x:Name="AssetList"
                                          Visibility="Collapsed"
                                          SelectionChanged="Asset_SelectionChanged"
                                          IsMultiSelectCheckBoxEnabled="False"
                                          SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="64" Padding="8,5" ColumnSpacing="12"
                                                  AutomationProperties.Name="{Binding Name}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource AccentSurfaceBrush}">
                                                    <FontIcon Glyph="{Binding Glyph}" Foreground="{StaticResource AccentTextBrush}" FontSize="18" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Padding="8,3" CornerRadius="8" Background="{StaticResource SubtleSurfaceBrush}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ArchiveName}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <ListView x:Name="MbAssetList"
                                          Visibility="Collapsed"
                                          SelectionChanged="Asset_SelectionChanged"
                                          IsMultiSelectCheckBoxEnabled="False"
                                          SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="48" Padding="10,7" ColumnSpacing="8"
                                                  AutomationProperties.Name="{Binding Name}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Padding="7,2" CornerRadius="7" Background="{StaticResource SubtleSurfaceBrush}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ArchiveName}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" FontSize="38" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="当前文件夹没有匹配资源" Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="PreviewPanel" Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid x:Name="PreviewHost">
                                    <Grid x:Name="ImagePreviewPanel">
                                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="14">
                                            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="18" />
                                        </Border>
                                    </Grid>
                                    <Grid x:Name="SoundPreviewPanel" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="14">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                                                <Border Width="104" Height="104" CornerRadius="52" Background="{StaticResource AccentSurfaceBrush}">
                                                    <FontIcon Glyph="&#xE8D6;" FontSize="44" Foreground="{StaticResource AccentTextBrush}" />
                                                </Border>
                                                <TextBlock x:Name="SoundNameText" Text="选择声音文件" Foreground="{StaticResource PrimaryTextBrush}" FontSize="18" TextAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ContentControl x:Name="AudioPlayerHost" Grid.Row="1" Margin="0,12,0,0" />
                                    </Grid>
                                    <ContentControl x:Name="ModelPreviewHost"
                                                    Visibility="Collapsed"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch" />
                                    <Grid x:Name="MbTableDataPanel" Visibility="Collapsed">
                                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="14" Padding="16">
                                            <Grid RowSpacing="12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="4">
                                                        <TextBlock x:Name="MbTableNameText" Text="选择一个 MB 表" Foreground="{StaticResource PrimaryTextBrush}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock x:Name="MbTablePathText" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock x:Name="MbDataSummaryText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                                        <Button x:Name="MbExportButton" Click="ExportSelectedButton_Click" IsEnabled="False" Padding="10,5">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <FontIcon Glyph="&#xE896;" FontSize="13" />
                                                                <TextBlock Text="导出表" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button x:Name="MbPropertiesButton" Click="PropertiesButton_Click" IsEnabled="False" Padding="10,5">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <FontIcon Glyph="&#xE946;" FontSize="13" />
                                                                <TextBlock Text="属性" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Grid.Row="1" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.1*" />
                                                        <ColumnDefinition Width="0.9*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10">
                                                        <Grid RowSpacing="8">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="记录列表" Foreground="{StaticResource AccentTextBrush}" FontWeight="SemiBold" />
                                                                <TextBlock x:Name="MbRecordCountText" Grid.Column="1" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                                            </Grid>
                                                            <Grid Grid.Row="1">
                                                                <ListView x:Name="MbRecordList"
                                                                          SelectionMode="Single"
                                                                          SelectionChanged="MbRecordList_SelectionChanged">
                                                                    <ListView.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid MinHeight="58" Padding="8,7" ColumnSpacing="10">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="70" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <Border Height="24" Padding="7,2" CornerRadius="7" Background="{StaticResource SubtleSurfaceBrush}" VerticalAlignment="Top">
                                                                                    <TextBlock Text="{Binding SourceRowText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" TextAlignment="Center" />
                                                                                </Border>
                                                                                <StackPanel Grid.Column="1" Spacing="3">
                                                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                                    <TextBlock Text="{Binding PreviewText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ListView.ItemTemplate>
                                                                </ListView>
                                                                <StackPanel x:Name="MbRecordEmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                                                    <FontIcon Glyph="&#xE721;" FontSize="32" Foreground="{StaticResource MutedTextBrush}" />
                                                                    <TextBlock Text="这个表没有可显示的记录" Foreground="{StaticResource SecondaryTextBrush}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>

                                                    <Border Grid.Column="1" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                                                        <Grid RowSpacing="10">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>
                                                            <StackPanel Spacing="3">
                                                                <TextBlock Text="字段解释" Foreground="{StaticResource AccentTextBrush}" FontWeight="SemiBold" />
                                                                <TextBlock x:Name="MbRecordTitleText" Text="选择左侧记录查看字段" Foreground="{StaticResource PrimaryTextBrush}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <TextBlock x:Name="MbRecordSubtitleText" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                                <StackPanel Spacing="10">
                                                                    <ListView x:Name="MbFieldList" SelectionMode="None">
                                                                        <ListView.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Grid Padding="0,7" ColumnSpacing="12">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="150" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <StackPanel Spacing="2">
                                                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                                        <TextBlock Text="{Binding IndexText}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                                                                    </StackPanel>
                                                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                                                        <TextBlock Text="{Binding Value}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                                                                        <TextBlock Text="{Binding Note}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" />
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ListView.ItemTemplate>
                                                                    </ListView>
                                                                    <Border x:Name="MbRecordExtraPanel" Visibility="Collapsed" Background="{StaticResource SubtleSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                                                        <StackPanel Spacing="6">
                                                                            <TextBlock Text="关联解析" Foreground="{StaticResource AccentTextBrush}" FontWeight="SemiBold" />
                                                                            <TextBlock x:Name="MbRecordExtraText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>
                                                            </ScrollViewer>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <Grid x:Name="GenericPreviewPanel" Visibility="Collapsed">
                                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="14">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollMode="Disabled"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          HorizontalContentAlignment="Stretch"
                                                          Padding="24">
                                                <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Spacing="12">
                                                    <Border x:Name="GenericPreviewIconBorder" Width="82" Height="82" CornerRadius="24" Background="{StaticResource AccentSurfaceBrush}" HorizontalAlignment="Left">
                                                        <FontIcon x:Name="GenericPreviewIcon" Glyph="&#xE8A5;" FontSize="36" Foreground="{StaticResource AccentTextBrush}" />
                                                    </Border>
                                                    <TextBlock x:Name="GenericPreviewNameText" Text="选择一个资源文件" Foreground="{StaticResource PrimaryTextBrush}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="GenericPreviewRawNameText" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                                    <Border x:Name="GenericExplanationCard" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,6,0,0">
