<UserControl
    x:Class="XunxianDpkViewer.Controls.EffectPreviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}" CornerRadius="14">
            <Grid x:Name="PreviewSurface">
                <Image x:Name="RasterImage" Stretch="Uniform" IsHitTestVisible="False" />
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Padding="10,6"
                        Background="{StaticResource SurfaceBrush}" CornerRadius="8">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="EffectNameText" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" />
                        <TextBlock x:Name="EffectSummaryText" Visibility="Collapsed" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                        <TextBlock x:Name="SceneSummaryText" Visibility="Collapsed" Foreground="{StaticResource AccentTextBrush}" FontSize="11" />
                    </StackPanel>
                </Border>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14" Padding="4"
                        Background="{StaticResource SurfaceBrush}" CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <ToggleButton x:Name="AutoSceneButton" Content="自动" IsChecked="True"
                                      Tag="Auto" Click="SceneModeButton_Click" />
                        <ToggleButton x:Name="CharacterSceneButton" Content="角色"
                                      Tag="Character" Click="SceneModeButton_Click" />
                        <ToggleButton x:Name="TargetSceneButton" Content="目标"
                                      Tag="Target" Click="SceneModeButton_Click" />
                        <ToggleButton x:Name="GroundSceneButton" Content="地面"
                                      Tag="Ground" Click="SceneModeButton_Click" />
                        <ToggleButton x:Name="RawSceneButton" Content="原始"
                                      Tag="Raw" Click="SceneModeButton_Click" />
                    </StackPanel>
                </Border>
                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE7FC;" FontSize="48" Foreground="{StaticResource AccentTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyText"
                               Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="UsagePanel" Grid.Row="1" Margin="0,12,0,0" Padding="12"
                Background="{StaticResource SurfaceAltBrush}" CornerRadius="12" Visibility="Collapsed">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE721;" Foreground="{StaticResource AccentTextBrush}" />
                    <TextBlock Grid.Column="1" Text="游戏内归属" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock x:Name="UsageStatusText" Grid.Column="2" HorizontalAlignment="Right"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                </Grid>
                <Grid Grid.Row="1" ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="关联技能" Foreground="{StaticResource AccentTextBrush}" FontSize="12" />
                        <TextBlock x:Name="SkillUsageText" Foreground="{StaticResource PrimaryTextBrush}"
                                   FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="使用角色 / 怪物" Foreground="{StaticResource AccentTextBrush}" FontSize="12" />
                        <TextBlock x:Name="UserUsageText" Foreground="{StaticResource PrimaryTextBrush}"
                                   FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="3">
                        <TextBlock Text="副本 / 场景" Foreground="{StaticResource AccentTextBrush}" FontSize="12" />
                        <TextBlock x:Name="SceneUsageText" Foreground="{StaticResource PrimaryTextBrush}"
                                   FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="TimelinePanel" Grid.Row="2" Margin="0,12,0,0" Padding="12"
                Background="{StaticResource SurfaceAltBrush}" CornerRadius="12" Visibility="Collapsed">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PlayPauseButton" Width="38" Height="36" Click="PlayPauseButton_Click">
                    <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" />
                </Button>
                <Slider x:Name="Timeline" Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="1"
                        ValueChanged="Timeline_ValueChanged"
                        PointerPressed="Timeline_PointerPressed"
                        PointerReleased="Timeline_PointerReleased"
                        PointerCanceled="Timeline_PointerCanceled"
                        PointerCaptureLost="Timeline_PointerCaptureLost" />
                <TextBlock x:Name="FrameText" Grid.Column="2" VerticalAlignment="Center"
                           Foreground="{StaticResource PrimaryTextBrush}" MinWidth="82" TextAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
