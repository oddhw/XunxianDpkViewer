                                                                                                </StackPanel>
                                                                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" TextWrapping="Wrap" />
                                                                                                <TextBlock Text="{Binding Path}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" />
                                                                                            </StackPanel>
                                                                                            <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                                                                        </Grid>
                                                                                    </Button>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
