                                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Spacing="4">
                                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                        <Border Padding="6,1" CornerRadius="6" Background="{StaticResource AccentSurfaceBrush}">
                                                                            <TextBlock Text="{Binding Category}" Foreground="{StaticResource AccentTextBrush}" FontSize="10" />
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding MatchReason}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                                <StackPanel x:Name="GlobalSearchEmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                                    <FontIcon Glyph="&#xE721;" FontSize="36" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Text="输入关键词后开始反查" Foreground="{StaticResource SecondaryTextBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                        <ScrollViewer x:Name="GlobalSearchDetailScrollViewer"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnSpacing="14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="86" Height="86" CornerRadius="12" Background="{StaticResource SubtleSurfaceBrush}">
                                                        <Image x:Name="GlobalSearchPreviewImage" Stretch="UniformToFill" />
