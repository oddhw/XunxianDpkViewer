                                                        <StackPanel MinHeight="46" Padding="8,6" Spacing="2">
                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
