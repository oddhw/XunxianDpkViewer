                                                                <TextBlock Text="{Binding CompactStats}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnSpacing="14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="86" Height="86" CornerRadius="12" Background="{StaticResource SubtleSurfaceBrush}">
                                                        <Image x:Name="DungeonMonsterPortraitImage" Stretch="UniformToFill" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock x:Name="DungeonMonsterNameText" Text="选择一个怪物" Foreground="{StaticResource PrimaryTextBrush}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="DungeonMonsterMetaText" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="DungeonMonsterExplainText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
                                                    </StackPanel>
                                                </Grid>

                                                <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Text="核心属性" Foreground="{StaticResource AccentTextBrush}" FontWeight="SemiBold" />
                                                        <ItemsControl x:Name="DungeonMonsterStatList">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Padding="0,5" ColumnSpacing="12">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="130" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                                            <TextBlock Text="{Binding Value}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                            <TextBlock Text="{Binding Note}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Visibility="Collapsed" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>

                                                <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Text="隐藏机制 / 状态" Foreground="{StaticResource AccentTextBrush}" FontWeight="SemiBold" />
                                                        <TextBlock x:Name="DungeonMonsterHiddenText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>

                                                <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Text="掉落组" Foreground="{StaticResource AccentTextBrush}" FontWeight="SemiBold" />
                                                        <ItemsControl x:Name="DungeonMonsterDropList">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Padding="0,5" Spacing="2">
                                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </NavigationView.Content>
        </NavigationView>

        <Border x:Name="PathSetupPanel"
                Grid.Row="1"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="520"
                Padding="34"
                Background="#F0121A27"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="20">
            <StackPanel Spacing="14" HorizontalAlignment="Stretch">
                <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource AccentSurfaceBrush}" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE8B7;" FontSize="28" Foreground="{StaticResource AccentTextBrush}" />
                </Border>
                <TextBlock Text="先选择《新寻仙》客户端目录" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Center" />
                <TextBlock Text="可以选择游戏安装目录，也可以直接选择 res 目录。程序会记住这个位置，换电脑后首次启动会重新提示。"
                           Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                <Button Content="选择客户端目录" Click="ChooseInitialPathButton_Click" HorizontalAlignment="Center" Padding="22,10" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
