                                    <StackPanel Spacing="4">
                                        <TextBlock Text="全局资料中心" Foreground="{StaticResource PrimaryTextBrush}" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock x:Name="GlobalSearchStatusText" Text="输入名称、ID、图标号或路径后，自动整理物品、套装、怪物、资源文件和引用关系。" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="10,5" CornerRadius="8" Background="{StaticResource SubtleSurfaceBrush}" VerticalAlignment="Top">
                                        <TextBlock x:Name="GlobalSearchCountText" Foreground="{StaticResource AccentTextBrush}" FontSize="12" />
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.05*" />
                                        <ColumnDefinition Width="1.15*" />
