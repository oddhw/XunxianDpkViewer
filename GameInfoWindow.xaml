                                                    <Grid>
                                                        <Image x:Name="SelectedWeaponImage" Stretch="Uniform" />
                                                        <FontIcon x:Name="SelectedWeaponFallback" Glyph="&#xE7FC;" Foreground="{StaticResource MutedTextBrush}" FontSize="25" Visibility="Collapsed" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                    <TextBlock x:Name="SelectedWeaponNameText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="SelectedWeaponMetaText" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Spacing="7">
                                                <TextBlock Text="武器属性" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" />
                                                <Grid UseLayoutRounding="True">
                                                    <Image x:Name="SelectedWeaponTooltipFrame" Stretch="Fill" NineGrid="12,12,13,13" />
                                                    <ContentPresenter x:Name="SelectedWeaponTooltipHost" Margin="6,6,6,7" />
                                                </Grid>
                                            </StackPanel>

                                            <Border Height="1" Background="{StaticResource AppBorderBrush}" />

                                            <StackPanel x:Name="WuhunPanel" Spacing="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="武魂培养" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" />
                                                        <TextBlock x:Name="WuhunCapText" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                                    </StackPanel>
                                                    <ComboBox
                                                        x:Name="WuhunLevelBox"
                                                        Grid.Column="1"
                                                        Width="150"
                                                        FontFamily="{StaticResource ClientGameFont}"
                                                        DisplayMemberPath="DisplayName"
                                                        SelectionChanged="WuhunLevelBox_SelectionChanged" />
                                                </Grid>

                                                <TextBlock x:Name="WuhunUnavailableText" Visibility="Collapsed" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />

                                                <Grid x:Name="WuhunComparisonPanel" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="26" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="9">
                                                        <StackPanel Spacing="7">
                                                            <TextBlock Text="原始装备" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                                            <TextBlock x:Name="WuhunCurrentTitleText" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" TextWrapping="Wrap" />
                                                            <ItemsControl x:Name="WuhunCurrentTraitsList">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource AccentTextBrush}" TextWrapping="Wrap" Margin="0,0,0,3" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                    <FontIcon Grid.Column="1" Glyph="&#xE72A;" FontSize="16" Foreground="{StaticResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="9">
                                                        <StackPanel Spacing="7">
                                                            <TextBlock Text="目标装备" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                                            <TextBlock x:Name="WuhunTargetTitleText" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" TextWrapping="Wrap" />
                                                            <ItemsControl x:Name="WuhunTargetTraitsList">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource AccentTextBrush}" TextWrapping="Wrap" Margin="0,0,0,3" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <Border x:Name="WuhunCostPanel" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="48" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="48" Height="48" Padding="3" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="2">
                                                            <Grid>
                                                                <Image x:Name="WuhunMaterialImage" Stretch="Uniform" />
                                                                <FontIcon x:Name="WuhunMaterialFallback" Glyph="&#xE7C3;" Foreground="{StaticResource MutedTextBrush}" FontSize="20" Visibility="Collapsed" />
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock x:Name="WuhunMaterialNameText" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" />
                                                            <TextBlock x:Name="WuhunCostText" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock x:Name="WuhunSuccessText" Foreground="{StaticResource AccentTextBrush}" HorizontalAlignment="Right" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="WuhunAdvanceButton" Content="强化" FontFamily="{StaticResource ClientGameFont}" HorizontalAlignment="Stretch" Click="WuhunAdvanceButton_Click" />
                                                    <Button x:Name="WuhunResetButton" Grid.Column="1" Content="重置" FontFamily="{StaticResource ClientGameFont}" HorizontalAlignment="Stretch" Click="WuhunResetButton_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Grid>

                        <StackPanel x:Name="LoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <ProgressRing IsActive="True" Width="38" Height="38" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>

                        <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9">
                            <FontIcon Glyph="&#xE721;" FontSize="34" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
