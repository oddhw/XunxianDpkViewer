                                                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                                                   FontSize="12"
                                                                                   TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>

                                                <Border x:Name="GlobalSearchSkillsPanel"
                                                        Visibility="Collapsed"
                                                        Background="{StaticResource SurfaceRaisedBrush}"
