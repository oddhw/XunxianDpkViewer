                                                        <TextBlock x:Name="GlobalSearchDetailTitleText" Text="选择一条结果" Foreground="{StaticResource PrimaryTextBrush}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="GlobalSearchDetailMetaText" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="GlobalSearchDetailSourceText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>

                                                <Border x:Name="GlobalSearchModelPanel"
                                                        Visibility="Collapsed"
                                                        Background="{StaticResource SurfaceRaisedBrush}"
                                                        BorderBrush="{StaticResource AppBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="12">
                                                    <Grid RowSpacing="8">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="360" />
                                                        </Grid.RowDefinitions>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
