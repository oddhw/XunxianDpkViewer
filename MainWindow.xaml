                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Margin="0,3"
                                                                            Padding="10"
                                                                            Background="{StaticResource SubtleSurfaceBrush}"
                                                                            BorderBrush="{StaticResource AppBorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="8">
                                                                        <Grid ColumnSpacing="10">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="54" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Border Width="50"
                                                                                    Height="50"
                                                                                    CornerRadius="7"
                                                                                    Background="{StaticResource SurfaceAltBrush}"
                                                                                    VerticalAlignment="Top">
                                                                                <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                                                            </Border>
                                                                            <StackPanel Grid.Column="1" Spacing="3">
                                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                    <TextBlock Text="{Binding Name}"
                                                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                                                               FontSize="13"
                                                                                               FontWeight="SemiBold"
                                                                                               TextWrapping="Wrap" />
