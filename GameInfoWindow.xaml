<Window
    x:Class="XunxianDpkViewer.GameInfoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="游戏资料">
    <Grid Background="{StaticResource AppBackgroundBrush}" RequestedTheme="Dark" Loaded="GameInfoWindow_Loaded">
        <Grid.Resources>
            <FontFamily x:Key="ClientGameFont">ms-appx:///Assets/Fonts/fzlth_gb18030.ttf#FZLanTingHei-R-GB18030</FontFamily>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ClientGameFont}" />
            </Style>
            <Style x:Key="CategoryItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style x:Key="GameItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style x:Key="WanxiangImageButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="WanxiangUpgradeButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="100" />
                <Setter Property="Height" Value="25" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Width="100" Height="25" Background="Transparent" UseLayoutRounding="True">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ButtonFrameTransform.Y" Value="-25" />
                                                <Setter Target="ButtonText.Foreground" Value="#FFFFFFCC" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ButtonFrameTransform.Y" Value="-50" />
                                                <Setter Target="ButtonText.Foreground" Value="#FFFFFFCC" />
                                                <Setter Target="ButtonLabel.Margin" Value="8,1,8,5" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ButtonFrameTransform.Y" Value="-75" />
                                                <Setter Target="ButtonText.Foreground" Value="#FF888888" />
                                                <Setter Target="ButtonTextOutline.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Canvas Width="100" Height="25" IsHitTestVisible="False">
                                    <Canvas.Clip><RectangleGeometry Rect="0,0,100,25" /></Canvas.Clip>
                                    <Image
                                        Width="139.1304"
                                        Height="128"
                                        Canvas.Left="-15.2174"
                                        Canvas.Top="-3"
                                        Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                        Stretch="Fill"
                                        IsHitTestVisible="False">
                                        <Image.RenderTransform><TranslateTransform x:Name="ButtonFrameTransform" /></Image.RenderTransform>
                                    </Image>
                                </Canvas>

                                <Grid
                                    x:Name="ButtonLabel"
                                    Margin="8,0,8,6"
                                    IsHitTestVisible="False">
                                    <Grid x:Name="ButtonTextOutline" Opacity="0.9">
                                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource ClientGameFont}" FontSize="16" Foreground="#FF140A02" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-1,-1,1,1" />
                                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource ClientGameFont}" FontSize="16" Foreground="#FF140A02" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,1" />
                                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource ClientGameFont}" FontSize="16" Foreground="#FF140A02" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,-1,-1,1" />
                                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource ClientGameFont}" FontSize="16" Foreground="#FF140A02" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-1,0,1,0" />
                                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource ClientGameFont}" FontSize="16" Foreground="#FF140A02" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,-1,0" />
                                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource ClientGameFont}" FontSize="16" Foreground="#FF140A02" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-1,1,1,-1" />
                                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource ClientGameFont}" FontSize="16" Foreground="#FF140A02" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,-1" />
                                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource ClientGameFont}" FontSize="16" Foreground="#FF140A02" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,1,-1,-1" />
                                    </Grid>
                                    <TextBlock
                                        x:Name="ButtonText"
                                        Text="{TemplateBinding Content}"
                                        FontFamily="{StaticResource ClientGameFont}"
                                        FontSize="16"
                                        Foreground="White"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource TopBarBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="游戏资料" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Click="CloseButton_Click" VerticalAlignment="Center" Padding="15,8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE711;" FontSize="13" />
                        <TextBlock Text="关闭" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="214" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="4,3,4,14" Spacing="3">
                        <TextBlock Text="资料分类" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" />
                    </StackPanel>
                    <ListView
                        x:Name="CategoryList"
                        Grid.Row="1"
                        IsItemClickEnabled="False"
                        SelectionMode="Single"
                        ItemContainerStyle="{StaticResource CategoryItemStyle}"
                        SelectionChanged="CategoryList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="62" Padding="12,8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" Background="{StaticResource AccentSurfaceBrush}" CornerRadius="4" VerticalAlignment="Center">
                                        <FontIcon Glyph="{Binding Glyph}" Foreground="{StaticResource AccentTextBrush}" FontSize="17" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="{Binding CountText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="92" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="22,14">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="330" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <TextBlock x:Name="CategoryTitleText" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                    <Border x:Name="CategoryCountBadge" Background="{StaticResource AccentSurfaceBrush}" CornerRadius="3" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock x:Name="CategoryCountText" FontSize="11" Foreground="{StaticResource AccentTextBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="CategoryDescriptionText" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBox
                                x:Name="InfoSearchBox"
                                Grid.Column="1"
                                FontFamily="{StaticResource ClientGameFont}"
                                VerticalAlignment="Center"
                                TextChanged="InfoSearchBox_TextChanged" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="TimelineView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="TimelineList" Margin="22,20,30,34">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,22" ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid>
                                                <Rectangle Width="2" Fill="{StaticResource AppBorderBrush}" HorizontalAlignment="Center" Margin="0,20,0,-28" />
                                                <Ellipse Width="14" Height="14" Fill="{StaticResource AccentBrush}" Stroke="{StaticResource AccentTextBrush}" StrokeThickness="2" VerticalAlignment="Top" Margin="0,16,0,0" />
                                            </Grid>

                                            <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="18,15">
                                                <StackPanel Spacing="13">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="{Binding Name}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" />
                                                            <TextBlock Text="{Binding Summary}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Visibility="{Binding SummaryVisibility}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="{StaticResource AccentSurfaceBrush}" CornerRadius="3" Padding="9,4" VerticalAlignment="Top" Visibility="{Binding PeriodVisibility}">
                                                            <TextBlock Text="{Binding Period}" FontSize="11" Foreground="{StaticResource AccentTextBrush}" />
                                                        </Border>
                                                    </Grid>

                                                    <ListView
                                                        ItemsSource="{Binding Records}"
                                                        SelectionMode="None"
                                                        IsItemClickEnabled="False"
                                                        ItemContainerStyle="{StaticResource GameItemStyle}"
                                                        MaxHeight="520">
                                                        <ListView.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="258" ItemHeight="76" />
                                                            </ItemsPanelTemplate>
                                                        </ListView.ItemsPanel>
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="9" Margin="0,0,8,0" ToolTipService.Placement="Mouse">
                                                                    <ToolTipService.ToolTip>
                                                                        <ToolTip Padding="0" Background="Transparent" BorderThickness="0">
                                                                            <ToolTip.Template>
                                                                                <ControlTemplate TargetType="ToolTip">
                                                                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                                                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                                                </ControlTemplate>
                                                                            </ToolTip.Template>
                                                                            <Grid MaxWidth="420" UseLayoutRounding="True">
                                                                                <Image Source="{Binding TooltipFrameSource}" Stretch="Fill" NineGrid="12,12,13,13" />
                                                                                <ContentPresenter Margin="6,6,6,7" Content="{Binding TooltipContent}" />
                                                                            </Grid>
                                                                        </ToolTip>
                                                                    </ToolTipService.ToolTip>
                                                                    <Grid ColumnSpacing="10">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="54" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Width="54" Height="54" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="3">
                                                                            <Grid>
                                                                                <Image Source="{Binding ImageSource}" Stretch="Uniform" Margin="3" Visibility="{Binding ImageVisibility}" />
                                                                                <FontIcon Glyph="&#xE7FC;" Foreground="{StaticResource MutedTextBrush}" FontSize="22" Visibility="{Binding FallbackVisibility}" />
                                                                            </Grid>
                                                                        </Border>
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{Binding QualityBrush}" />
                                                                            <TextBlock Text="{Binding Group}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Grid x:Name="YinYangView" Visibility="Collapsed" Margin="18,16,18,20" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Visibility="Collapsed" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="曲灵玉" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <ToggleButton
                                            x:Name="YinYangYinButton"
                                            MinWidth="112"
                                            Tag="阴"
                                            Click="YinYangJadeButton_Click">
                                            <TextBlock x:Name="YinYangYinButtonText" Text="曲灵玉·阴" FontFamily="{StaticResource ClientGameFont}" />
                                        </ToggleButton>
                                        <ToggleButton
                                            x:Name="YinYangYangButton"
                                            MinWidth="112"
                                            Tag="阳"
                                            Click="YinYangJadeButton_Click">
                                            <TextBlock x:Name="YinYangYangButtonText" Text="曲灵玉·阳" FontFamily="{StaticResource ClientGameFont}" />
                                        </ToggleButton>
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="YinYangCatalogStatusText"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="YinYangActiveSideText"
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource AccentTextBrush}" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="1*" MinWidth="560" />
                                </Grid.ColumnDefinitions>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="12">
                                            <TextBlock x:Name="YinYangYinEditorTitle" Text="曲灵玉·阴" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" />
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="附魔诀" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" />
                                        </StackPanel>

                                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="11">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="附魔属性1" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                                <ComboBox
                                                    x:Name="YinYangEnchantGroup1Box"
                                                    DisplayMemberPath="Name"
                                                    FontFamily="{StaticResource ClientGameFont}"
                                                    SelectionChanged="YinYangEnchantGroup1Box_SelectionChanged" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox
                                                        x:Name="YinYangEnchantQuality1Box"
                                                        DisplayMemberPath="Name"
                                                        FontFamily="{StaticResource ClientGameFont}"
                                                        SelectionChanged="YinYangEnchantQuality1Box_SelectionChanged" />
                                                    <ComboBox
                                                        x:Name="YinYangEnchantAttribute1Box"
                                                        Grid.Column="1"
                                                        DisplayMemberPath="Text"
                                                        FontFamily="{StaticResource ClientGameFont}"
                                                        SelectionChanged="YinYangEnchantAttribute1Box_SelectionChanged" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="11">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="附魔属性2" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                                <ComboBox
                                                    x:Name="YinYangEnchantGroup2Box"
                                                    DisplayMemberPath="Name"
                                                    FontFamily="{StaticResource ClientGameFont}"
                                                    SelectionChanged="YinYangEnchantGroup2Box_SelectionChanged" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox
                                                        x:Name="YinYangEnchantQuality2Box"
                                                        DisplayMemberPath="Name"
                                                        FontFamily="{StaticResource ClientGameFont}"
                                                        SelectionChanged="YinYangEnchantQuality2Box_SelectionChanged" />
                                                    <ComboBox
                                                        x:Name="YinYangEnchantAttribute2Box"
                                                        Grid.Column="1"
                                                        DisplayMemberPath="Text"
                                                        FontFamily="{StaticResource ClientGameFont}"
                                                        SelectionChanged="YinYangEnchantAttribute2Box_SelectionChanged" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Spacing="2">
                                            <TextBlock Text="附灵诀" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" />
                                        </StackPanel>
                                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="11">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="附灵属性" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                                <ComboBox
                                                    x:Name="YinYangSpiritGroupBox"
                                                    DisplayMemberPath="Name"
                                                    FontFamily="{StaticResource ClientGameFont}"
                                                    SelectionChanged="YinYangSpiritGroupBox_SelectionChanged" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox
                                                        x:Name="YinYangSpiritQualityBox"
                                                        DisplayMemberPath="Name"
                                                        FontFamily="{StaticResource ClientGameFont}"
                                                        SelectionChanged="YinYangSpiritQualityBox_SelectionChanged" />
                                                    <ComboBox
                                                        x:Name="YinYangSpiritAttributeBox"
                                                        Grid.Column="1"
                                                        DisplayMemberPath="Text"
                                                        FontFamily="{StaticResource ClientGameFont}"
                                                        SelectionChanged="YinYangSpiritAttributeBox_SelectionChanged" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Spacing="2">
                                            <TextBlock Text="附魂诀" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" />
                                        </StackPanel>
                                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="11">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="附魂属性" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                                <ComboBox
                                                    x:Name="YinYangSoulGroupBox"
                                                    DisplayMemberPath="Name"
                                                    FontFamily="{StaticResource ClientGameFont}"
                                                    SelectionChanged="YinYangSoulGroupBox_SelectionChanged" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox
                                                        x:Name="YinYangSoulQualityBox"
                                                        DisplayMemberPath="Name"
                                                        FontFamily="{StaticResource ClientGameFont}"
                                                        SelectionChanged="YinYangSoulQualityBox_SelectionChanged" />
                                                    <ComboBox
                                                        x:Name="YinYangSoulAttributeBox"
                                                        Grid.Column="1"
                                                        DisplayMemberPath="Text"
                                                        FontFamily="{StaticResource ClientGameFont}"
                                                        SelectionChanged="YinYangSoulAttributeBox_SelectionChanged" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="12">
                                            <TextBlock x:Name="YinYangYangEditorTitle" Text="曲灵玉·阳" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" />
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="附魔诀" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" />
                                            </StackPanel>
                                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="11">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="附魔属性1" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                                    <ComboBox x:Name="YinYangYangEnchantGroup1Box" DisplayMemberPath="Name" FontFamily="{StaticResource ClientGameFont}" SelectionChanged="YinYangEnchantGroup1Box_SelectionChanged" />
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <ComboBox x:Name="YinYangYangEnchantQuality1Box" DisplayMemberPath="Name" FontFamily="{StaticResource ClientGameFont}" SelectionChanged="YinYangEnchantQuality1Box_SelectionChanged" />
                                                        <ComboBox x:Name="YinYangYangEnchantAttribute1Box" Grid.Column="1" DisplayMemberPath="Text" FontFamily="{StaticResource ClientGameFont}" SelectionChanged="YinYangEnchantAttribute1Box_SelectionChanged" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="11">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="附魔属性2" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                                    <ComboBox x:Name="YinYangYangEnchantGroup2Box" DisplayMemberPath="Name" FontFamily="{StaticResource ClientGameFont}" SelectionChanged="YinYangEnchantGroup2Box_SelectionChanged" />
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <ComboBox x:Name="YinYangYangEnchantQuality2Box" DisplayMemberPath="Name" FontFamily="{StaticResource ClientGameFont}" SelectionChanged="YinYangEnchantQuality2Box_SelectionChanged" />
                                                        <ComboBox x:Name="YinYangYangEnchantAttribute2Box" Grid.Column="1" DisplayMemberPath="Text" FontFamily="{StaticResource ClientGameFont}" SelectionChanged="YinYangEnchantAttribute2Box_SelectionChanged" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
